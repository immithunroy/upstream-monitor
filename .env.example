# Server
NODE_ENV=production
PORT=5020

# MongoDB (container hostname inside docker network)
MONGODB_URI=mongodb://admin:change-me-mongo-password@mongodb:27017/upstream_monitor?authSource=admin

# MongoDB root credentials (used by docker-compose to secure the instance)
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=change-me-mongo-password

# Hourly schedule (cron)
TRACE_CRON=0 * * * *

# Ping / traceroute tuning
PING_COUNT=4
PING_TIMEOUT_MS=2500
TRACEROUTE_MAX_HOPS=30
TRACEROUTE_TIMEOUT_SECONDS=4

# Change detection thresholds
RTT_CHANGE_PERCENT_THRESHOLD=30
RTT_CHANGE_ABS_THRESHOLD_MS=15
PACKET_LOSS_THRESHOLD=5

# CORS
CORS_ORIGIN=*

# Admin panel
ADMIN_PASSWORD=change-me-admin-password
AUTH_TOKEN_SECRET=change-me-auth-token-secret
ADMIN_TOKEN_TTL_SECONDS=43200

# RIR ASN/company enrichment (team-cymru origin-ASN + RDAP)
RIR_REQUEST_TIMEOUT_MS=10000
RIR_ENRICH_CONCURRENCY=6
RIR_CACHE_TTL_HOURS=24
