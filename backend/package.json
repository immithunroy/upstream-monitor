{
  "name": "upstream-monitor-backend",
  "version": "1.0.0",
  "description": "Backend API + trace engine for the Upstream Monitoring System",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test:e2e": "tsx scripts/e2e.ts",
    "test:smoke": "tsx scripts/smoke.ts",
    "test:comparator": "tsx scripts/test-comparator.ts",
    "test:rir": "tsx scripts/test-rir.ts",
    "test:traceroute": "tsx scripts/test-traceroute.ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate-dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "migrate:from-mongo": "tsx scripts/migrate-mongo-to-postgres.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongoose": "^8.4.3",
    "multer": "^1.4.5-lts.2",
    "node-cron": "^3.0.3",
    "pdfkit": "^0.19.1",
    "prisma": "^6.19.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.14.8",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.17.6",
    "tsx": "^4.15.7",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
