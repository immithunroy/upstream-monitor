{
  "name": "upstream-monitor-backend",
  "version": "1.0.0",
  "description": "Backend API + trace engine for the Upstream Monitoring System",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test:e2e": "tsx scripts/e2e.ts",
    "test:smoke": "tsx scripts/smoke.ts",
    "test:rir": "tsx scripts/test-rir.ts",
    "test:traceroute": "tsx scripts/test-traceroute.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongoose": "^8.4.3",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.8",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.15.7",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
